{
  "name": "mastichari-massage",
  "version": "1.0.0",
  "private": true,
  "description": "Static multilingual site for Mastichari Massage (Konstantinos Fessaras, Kos, Greece)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/i18n-check.js && eleventy && node scripts/minify.js && node scripts/precompress.js",
    "watch": "eleventy --watch",
    "serve": "node server/index.js",
    "dev": "eleventy && node server/index.js",
    "images": "node scripts/process-images.js",
    "check": "node scripts/i18n-check.js",
    "start": "node server/index.js",
    "icons": "node scripts/build-icons.js",
    "fonts": "node scripts/build-fonts.js",
    "assets": "npm run fonts && npm run images && npm run icons",
    "audit": "node scripts/audit.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.33.5"
  }
}
