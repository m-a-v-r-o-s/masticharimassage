---
pagination: { data: buildLocales, size: 1, alias: loc }
permalink: "/{{ loc }}/index.html"
pageKey: home
pathKey: ""
eleventyExcludeFromCollections: true
---
{%- import "partials/icons.njk" as icon -%}
{%- import "partials/quotes.njk" as q -%}
{%- import "partials/pic.njk" as p -%}
{%- set svcs = business | serviceList(c) -%}

<section class="hero">
  <div class="wrap hero__inner">
    {#- The mark as the hero's ground, the light-ground counterpart to the footer's.
        It lives inside the wrap rather than the section so it stays anchored to the
        text column instead of to the viewport: centred on the section it would spend
        half its width under an opaque photograph on desktop. Bleeds off the left
        edge, which .hero { overflow: hidden } clips. Decorative, so hidden from
        assistive tech, and deliberately not lazy - see the footer's note. -#}
    <img class="hero__watermark" src="/assets/img/logo-watermark-colour-1200.png"
         width="1200" height="819" alt="" aria-hidden="true" decoding="async">
    <div class="stack">
      {#- The kicker is written as "<places> - <island>" in every locale, so the
          ornament goes where that dash already is. A locale that ever drops the
          dash simply renders one segment and no squiggle. -#}
      {%- set kick = c.home.heroKicker.split(" - ") -%}
      <p class="eyebrow eyebrow--rule">
        <span>{{ kick[0] }}</span>
        {%- if kick[1] %}<span class="eyebrow__rule">{{ icon.squiggle() }}</span><span>{{ kick[1] }}</span>{% endif -%}
      </p>
      <h1 class="hero__title">{{ c.home.heroTitle | stress | safe }} <span class="hero__title-accent">{{ c.home.heroTitleAccent | stress | safe }}</span></h1>
      <p class="lede">{{ c.home.heroLede }}</p>
      <div class="btn-row hero__actions">
        <a class="btn btn--accent" href="{{ business.contact.whatsappHref }}" rel="noopener">{{ icon.whatsapp() }} {{ c.home.heroPrimary }}</a>
        <a class="btn btn--ghost" href="/{{ locale }}/services/">{{ c.home.heroSecondary }}</a>
        <p class="hero__call">{{ c.home.heroCallPrefix }} <a href="{{ business.contact.phoneHref }}">{{ business.contact.phone }}</a></p>
      </div>
      <p class="badge">{{ icon.globe() }} {{ c.home.heroBadge }}</p>
    </div>
    <div class="hero__figure">
      <div class="hero__media hero__slides" data-slides
           data-slides-labels='{"pause": {{ c.ui.pauseSlideshow | dump }}, "play": {{ c.ui.playSlideshow | dump }}}'>
        <div class="hero__slide is-active">
          {{ p.pic(images, "hero-treatment-room", c.home.heroRoomAlt, "(min-width: 58em) 46vw, 100vw", "", true) }}
        </div>
        <div class="hero__slide">
          {{ p.pic(images, "session-back-massage-wide", c.home.heroImageAlt, "(min-width: 58em) 46vw, 100vw", "", "eager") }}
        </div>
        <div class="hero__slide">
          {{ p.pic(images, "session-shoulders-closeup", c.home.heroImageAlt2, "(min-width: 58em) 46vw, 100vw", "", "eager") }}
        </div>
        <button type="button" class="hero__slides-btn" data-slides-toggle
                aria-label="{{ c.ui.pauseSlideshow }}">
          <span class="hero__slides-icon" data-icon-pause>{{ icon.pause() }}</span>
          <span class="hero__slides-icon" data-icon-play hidden>{{ icon.play() }}</span>
        </button>
      </div>
      {#- Sits at the frame's lower left, the corner the slideshow's pause button
          leaves free. Decorative repetition of the lede's "since 2011", so it is
          hidden from assistive tech rather than read out twice. -#}
      <p class="hero__stat" aria-hidden="true">
        <span class="hero__stat-value">{{ c.home.heroStatValue }}</span>
        <span class="hero__stat-label">{{ c.home.heroStatLabel }}</span>
      </p>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>{{ c.home.introTitle }}</h2>
      <p>{{ c.home.introBody }}</p>
    </div>
    <div class="grid grid--2 reveal">
      {%- for p in c.home.points %}
      <div class="card">
        <h3>{{ p.title }}</h3>
        <p>{{ p.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--warm">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{{ c.nav.services }}</p>
      <h2>{{ c.home.servicesTitle }}</h2>
      <p>{{ c.home.servicesIntro }}</p>
    </div>
    {#- The home page shows only the three featured massages; the rest live on
        the services page, which the button below leads to. -#}
    <div class="grid grid--3 reveal">
      {%- for s in svcs | featured %}
      <a class="card card--link u-plain" href="/{{ locale }}/services/{{ s.slug }}/">
        <div class="card__media card__media--titled">
          {{ p.pic(images, "service-" + s.slug, s.imageAlt, "(min-width: 66em) 30vw, (min-width: 46em) 46vw, 100vw", "", false, "hero-treatment-room", c.ui.imagePendingAlt) }}
          <h3 class="card__media-title">{{ s.name }}</h3>
        </div>
        <p>{{ s.short }}</p>
        <p class="card__foot"><span class="card__link">{{ c.services.cardCta }}</span></p>
      </a>
      {%- endfor %}
    </div>
    <div class="btn-row u-mt-2">
      <a class="btn btn--primary" href="/{{ locale }}/services/">{{ c.home.servicesCta }}</a>
    </div>
    <p class="notice u-mt-2">{{ c.ui.priceNote }}</p>
  </div>
</section>

<section class="section">
  <div class="wrap grid grid--split">
    <div class="stack reveal">
      <p class="eyebrow">{{ c.home.howTitle }}</p>
      <h2>{{ c.home.ctaTitle }}</h2>
      <p>{{ c.home.ctaBody }}</p>
      <div class="btn-row">
        <a class="btn btn--accent" href="{{ business.contact.whatsappHref }}" rel="noopener">{{ icon.whatsapp() }} {{ c.ui.whatsapp }}</a>
        <a class="btn btn--primary" href="{{ business.contact.phoneHref }}">{{ icon.phone() }} {{ business.contact.phone }}</a>
        <a class="btn btn--ghost" href="/{{ locale }}/contact/">{{ c.ui.bookNow }}</a>
      </div>
    </div>
    <ol class="numbered reveal">
      {%- for s in c.home.howSteps %}
      <li><h3>{{ s.title }}</h3><p>{{ s.body }}</p></li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section section--warm">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>{{ c.ui.testimonialsTitle }}</h2>
    </div>
    <div class="reveal">
      {{ q.wall(testimonials.items | pickIds(["sylvie-philippe", "peter-2017", "heiko"]), c, L, locale) }}
    </div>
    <div class="btn-row u-mt-2">
      <a class="btn btn--ghost" href="{{ business.map.placeUrl }}" rel="noopener" target="_blank">{{ icon.star() }} {{ c.ui.reviewsGoogle }}</a>
      <a class="btn btn--ghost" href="{{ (business.social | byKey('tripadvisor')).url }}" rel="noopener" target="_blank">{{ icon.tripadvisor() }} {{ c.ui.reviewsTripadvisor }}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap grid grid--split">
    <div class="stack reveal">
      <p class="eyebrow">{{ c.nav.location }}</p>
      <h2>{{ c.home.areaTitle }}</h2>
      <p>{{ c.home.areaBody }}</p>
      <p><a class="btn btn--ghost" href="/{{ locale }}/location/">{{ c.home.areaCta }}</a></p>
    </div>
    <div class="reveal">
      {{ p.pic(images, "village-lane", c.home.areaImageAlt, "(min-width: 52em) 40vw, 100vw", "u-round") }}
    </div>
  </div>
</section>

{% include "partials/studio-map.njk" %}

<section class="section section--ink">
  <div class="wrap measure">
    <p class="notice notice--ink">{{ c.ui.wellnessNotice }}</p>
  </div>
</section>
