---
pagination: { data: buildLocales, size: 1, alias: loc }
permalink: "/{{ loc }}/about/index.html"
pageKey: about
pathKey: "about"
eleventyExcludeFromCollections: true
---
{%- import "partials/icons.njk" as icon -%}
{%- import "partials/quotes.njk" as q -%}
{%- import "partials/pic.njk" as p -%}

<section class="section">
  <div class="wrap grid grid--split">
    <div class="stack">
      <h1>{{ c.about.title }}</h1>
      <p class="lede">{{ c.about.lede }}</p>
      {%- for p in c.about.bio %}
      <p>{{ p }}</p>
      {%- endfor %}
      <div class="btn-row">
        <a class="btn btn--ghost" href="#testimonials">{{ icon.star() }} {{ c.ui.seeReviews }}</a>
      </div>
    </div>
    <div>
      {{ p.pic(images, "portrait-konstantinos", c.about.portraitAlt, "(min-width: 52em) 34vw, 100vw", "portrait") }}
    </div>
  </div>
  <div class="wrap u-mt-3">
    <figure class="img-band reveal">
      {{ p.pic(images, "session-forearm-technique", c.about.sessionAlt1, "(min-width: 74em) 1152px, 100vw") }}
    </figure>
  </div>
</section>

<section class="section section--warm">
  <div class="wrap lang-row reveal">
    <div class="section-head">
      <h2>{{ c.about.languagesTitle }}</h2>
      <p>{{ c.about.languagesBody }}</p>
    </div>
    {#- Decorative: the paragraph already names all six languages, so the flags
        repeat rather than add and are hidden from screen readers. -#}
    <p class="lang-flags" aria-hidden="true"><span>🇬🇷</span><span>🇬🇧</span><span>🇮🇹</span><span>🇫🇷</span><span>🇩🇪</span><span>🇷🇺</span></p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>{{ c.about.credentialsTitle }}</h2>
      <p>{{ c.about.credentialsIntro }}</p>
    </div>

    <div class="creds reveal">
      {%- for d in business.credentials.diplomas %}
      <div class="cred">
        <div>
          <h3>{{ c.about.credentialNames[d.key] }}</h3>
          {%- if d.certifier %}<p class="u-muted">{{ d.certifier }}</p>{% endif %}
          <dl>
            {%- if d.date %}
            <dt>{{ c.ui.issued }}</dt><dd>{{ d.date | formatDate(L.lang) }}</dd>
            {%- endif %}
            {%- if d.identifier %}
            <dt>{% if d.identifierLabel == "Protocol No." %}{{ c.ui.protocolNo }}{% else %}{{ c.ui.certNo }}{% endif %}</dt><dd>{{ d.identifier }}</dd>
            {%- endif %}
          </dl>
          {%- if not d.verified %}<p class="quote__t-note">{{ c.ui.notVerifiedYet }}</p>{% endif %}
        </div>
        {%- if d.image %}
        {#- image2 (a supporting document for the same credential) is tucked behind
            the certificate, so every card keeps the same frame size. -#}
        <figure{% if d.image2 %} class="cred__stack"{% endif %}>
          {%- if d.image2 %}
          {#- Stacked, the two scans are too small to read, so each opens full size. -#}
          <a data-lightbox href="/assets/img/r/{{ d.image }}-{{ images[d.image].w }}.jpg" target="_blank" rel="noopener">
            {{ p.pic(images, d.image, c.about.credentialNames[d.key] + " - " + d.certifier, "(min-width: 46em) 40vw, 100vw") }}
          </a>
          <a data-lightbox href="/assets/img/r/{{ d.image2 }}-{{ images[d.image2].w }}.jpg" target="_blank" rel="noopener">
            {{ p.pic(images, d.image2, c.about.credentialNames[d.key] + " - " + c.ui.attestation, "(min-width: 46em) 30vw, 70vw") }}
          </a>
          {%- else %}
          {{ p.pic(images, d.image, c.about.credentialNames[d.key] + " - " + d.certifier, "(min-width: 46em) 40vw, 100vw") }}
          {%- endif %}
        </figure>
        {%- endif %}
      </div>
      {%- endfor %}
    </div>

    {#- One shared viewer for the [data-lightbox] scans above; site.js fills it. -#}
    <dialog class="lightbox" data-lightbox-dialog>
      <button type="button" class="lightbox__close" aria-label="{{ c.nav.close }}">{{ icon.close() }}</button>
    </dialog>

    <div class="section-head reveal u-mt-3">
      <h2>{{ c.about.seminarsTitle }}</h2>
      <ul class="ticks">
        {%- for s in business.credentials.seminars %}
        <li>{{ c.about.seminarNames[s] }}</li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="section section--warm" id="testimonials">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>{{ c.ui.testimonialsTitle }}</h2>
    </div>
    <div class="reveal">
      {{ q.wall(testimonials.items | reverse, c, L, locale) }}
    </div>
    <div class="btn-row u-mt-2">
      <a class="btn btn--ghost" href="{{ business.map.placeUrl }}" rel="noopener" target="_blank">{{ icon.star() }} {{ c.ui.reviewsGoogle }}</a>
      <a class="btn btn--ghost" href="{{ (business.social | byKey('tripadvisor')).url }}" rel="noopener" target="_blank">{{ icon.tripadvisor() }} {{ c.ui.reviewsTripadvisor }}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap measure stack">
    <h2>{{ c.about.ctaTitle }}</h2>
    <p>{{ c.about.ctaBody }}</p>
    <div class="btn-row">
      <a class="btn btn--accent" href="{{ business.contact.whatsappHref }}" rel="noopener">{{ icon.whatsapp() }} {{ c.ui.whatsapp }}</a>
      <a class="btn btn--ghost" href="/{{ locale }}/contact/">{{ c.ui.bookNow }}</a>
    </div>
    <p class="notice">{{ c.ui.wellnessNotice }}</p>
  </div>
</section>
