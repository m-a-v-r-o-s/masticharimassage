{%- import "partials/icons.njk" as icon -%}
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="brand footer-brand" href="/{{ locale }}/">
        {% include "partials/mark.njk" %}
        <span class="brand__name">Mastichari Massage<span class="brand__sub">{{ business.address.locality }}, {{ business.address.region }}</span></span>
      </a>
      <p class="footer-blurb">{{ c.home.heroLede }}</p>
    </div>

    <div>
      <h2>{{ c.ui.footerLinks }}</h2>
      <ul>
        <li><a href="/{{ locale }}/">{{ c.nav.home }}</a></li>
        <li><a href="/{{ locale }}/services/">{{ c.nav.services }}</a></li>
        <li><a href="/{{ locale }}/about/">{{ c.nav.about }}</a></li>
        <li><a href="/{{ locale }}/location/">{{ c.nav.location }}</a></li>
        <li><a href="/{{ locale }}/contact/">{{ c.nav.contact }}</a></li>
      </ul>
    </div>

    <div>
      <h2>{{ c.ui.footerContact }}</h2>
      <ul>
        <li><a href="{{ business.contact.whatsappHref }}" rel="noopener">{{ icon.whatsapp() }} {{ business.contact.phone }}</a></li>
        <li><a href="{{ business.contact.phoneHref }}">{{ icon.phone() }} {{ business.contact.phone }}</a></li>
        <li><a href="{{ business.contact.emailHref }}">{{ icon.mail() }} {{ business.contact.email }}</a></li>
        <li>{{ c.ui.openingHours }}</li>
        <li>{{ business.address.locality }}, {{ business.address.region }}, GR</li>
      </ul>
      <h2 class="u-mt-15">Social</h2>
      <ul>
        {%- for s in business.social %}{% if s.publish != false %}
        <li><a href="{{ s.url }}" rel="noopener me">{{ s.label or (s.key | capitalize) }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p class="footer-legal">
      <a href="/{{ locale }}/privacy/">{{ c.ui.privacy }}</a>
      <a href="/{{ locale }}/terms/">{{ c.ui.terms }}</a>
      <a href="/{{ locale }}/cookies/">{{ c.ui.cookies }}</a>
      <button type="button" class="footer-legal__manage" data-cookie-manage>{{ c.ui.cookieSettings }}</button>
      <span>&copy; {{ site.year }} Konstantinos Fessaras. {{ c.ui.rights }}</span>
    </p>
    <p class="footer-credit">&copy; {{ site.year }} <a href="https://akosds.com" rel="noopener">Akos Digital Services</a></p>
  </div>
</footer>
