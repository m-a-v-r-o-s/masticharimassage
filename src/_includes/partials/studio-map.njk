{%- import "partials/icons.njk" as icon -%}
{#- Shared by home.njk and location.njk. The only iframe on the site - see
    server/security.js (frame-src) and the Cookies section of the privacy
    policy, which discloses this as the one third-party load the site makes.
    No loading="lazy": with it, the card rendered at the right size with its
    shadow but the iframe itself was still empty at the point the page was
    checked, so it now loads eagerly with the rest of the page instead. -#}
<section class="section section--warm">
  <div class="wrap grid grid--split">
    <div class="stack reveal">
      <p class="eyebrow">{{ c.ui.findMe }}</p>
      <h2>{{ c.location.mapTitle }}</h2>
      <p>{{ c.location.mapBody }}</p>
      <ul class="info-rows">
        <li>{{ icon.pin() }} {{ c.location.studioAddressLine }}</li>
        <li>{{ icon.phone() }} {{ c.ui.phoneLabel }}: {{ business.contact.phone }}</li>
        <li>{{ icon.clock() }} {{ c.ui.hoursLabel }}: {{ c.ui.openingHours }}</li>
      </ul>
      <div class="btn-row">
        <a class="btn btn--ghost" href="{{ business.map.placeUrl }}" rel="noopener">{{ c.location.mapCta }}</a>
        <a class="btn btn--ghost" href="{{ business.map.directionsUrl }}" rel="noopener">{{ c.location.directionsCta }}</a>
      </div>
    </div>
    <div class="reveal">
      <div class="map-embed u-round u-raise">
        <iframe src="{{ business.map.embedUrl }}" title="{{ business.name }} – {{ c.ui.googleMaps }}" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p class="map-embed__caption">{{ icon.pin() }} {{ c.location.studioAddressLine }}</p>
    </div>
  </div>
</section>
