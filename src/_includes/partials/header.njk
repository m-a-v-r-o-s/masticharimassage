{%- import "partials/icons.njk" as icon -%}
{%- set navItems = [
  { key: "home",     path: "",         label: c.nav.home },
  { key: "services", path: "services", label: c.nav.services },
  { key: "about",    path: "about",    label: c.nav.about },
  { key: "location", path: "location", label: c.nav.location },
  { key: "contact",  path: "contact",  label: c.nav.contact }
] -%}
{%- set switchable = [] -%}
{%- for l in locales.live %}{% if l.code in buildLocales %}{% set switchable = (switchable.push(l), switchable) %}{% endif %}{% endfor -%}
{%- if isDraftLocale %}{% set switchable = (switchable.push(L), switchable) %}{% endif -%}

<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href="/{{ locale }}/">
      {% include "partials/mark.njk" %}
      <span class="brand__name">Mastichari Massage</span>
    </a>

    <div class="header-actions">
      <div class="lang-picker">
        <button class="lang-picker__toggle" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="lang-picker-list">
          <span class="lang-picker__flag" aria-hidden="true">{{ L.flag }}</span>
          <span class="visually-hidden">{{ c.nav.languageSwitcher }}: {{ L.endonym }}</span>
        </button>
        <ul class="lang-picker__list" id="lang-picker-list" role="listbox" aria-label="{{ c.nav.languageSwitcher }}" hidden>
          {%- for l in switchable %}
          <li role="option"{% if l.code == locale %} aria-selected="true"{% else %} aria-selected="false"{% endif %}>
            <a lang="{{ l.lang }}" hreflang="{{ l.hreflang }}" href="/{{ l.code }}/{{ pagePath + '/' if pagePath }}"{% if l.code == locale %} aria-current="true"{% endif %}>
              <span class="lang-picker__flag" aria-hidden="true">{{ l.flag }}</span>
              <span>{{ l.endonym }}</span>
            </a>
          </li>
          {%- endfor %}
        </ul>
      </div>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="nav-toggle__icon nav-toggle__icon--open">{{ icon.menu() }}</span>
        <span class="nav-toggle__icon nav-toggle__icon--close">{{ icon.close() }}</span>
        <span>{{ c.nav.menu }}</span>
      </button>

      <nav class="site-nav" id="site-nav" aria-label="{{ c.nav.menu }}">
        <ul>
          {%- for item in navItems %}
          <li><a href="/{{ locale }}/{{ item.path + '/' if item.path }}"{% if item.key == pageKey or (item.key == "services" and pageKey == "service") %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>
  </div>
</header>
