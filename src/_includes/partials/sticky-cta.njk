{%- import "partials/icons.njk" as icon -%}
<div class="sticky-cta" role="group" aria-label="{{ c.ui.bookNow }}">
  <a class="btn btn--accent" href="{{ business.contact.whatsappHref }}" rel="noopener">{{ icon.whatsapp() }} {{ c.ui.whatsapp }}</a>
  <a class="btn btn--primary sticky-cta__call" href="{{ business.contact.phoneHref }}" aria-label="{{ c.ui.call }}">{{ icon.phone() }} <span class="sticky-cta__label">{{ c.ui.call }}</span></a>
</div>
